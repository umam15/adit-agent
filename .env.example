# salin ke .env lalu isi, atau set langsung sebagai env var container/systemd

# --- server adit ---
ADIT_BASE_URL=http://localhost:8000
ADIT_API_KEY=
ADIT_MAX_TOKENS=150
ADIT_TEMPERATURE=0.8
ADIT_TOP_K=20
ADIT_REQUEST_TIMEOUT=120

# --- Synology Chat ---
# Profile > Integration > Bot > buat "Outgoing Webhook", isi URL-nya ke:
#   http://<host-adit-agent>:9000/webhook/synology
# lalu salin token yang digenerate ke sini.
SYNOLOGY_OUTGOING_TOKEN=

# Profile > Integration > Incoming Webhook > buat webhook baru untuk channel
# tujuan, salin URL lengkapnya (sudah termasuk ?token=...) ke sini.
#
# CATATAN: URL ini bisa berasal dari dua jenis integrasi Synology Chat yang
# BEDA format payloadnya -- lihat SYNOLOGY_REPLY_TO_USER di bawah:
#   - "Incoming Webhook" polos (Profile > Integration > Incoming Webhook):
#     terikat ke satu channel tetap -> biarkan SYNOLOGY_REPLY_TO_USER=false.
#   - URL punya sebuah "Bot" (Profile > Integration > Bot): tidak terikat
#     channel, balasan HARUS ditujukan ke user tertentu -> set
#     SYNOLOGY_REPLY_TO_USER=true.
SYNOLOGY_INCOMING_WEBHOOK_URL=

# true kalau SYNOLOGY_INCOMING_WEBHOOK_URL di atas adalah URL milik Bot
# (bukan Incoming Webhook polos) -- lihat catatan di atas. Kalau true,
# balasan menyertakan "user_ids": [<user_id pengirim>] di payload supaya
# Synology tahu balasan itu untuk siapa.
SYNOLOGY_REPLY_TO_USER=false

SYNOLOGY_VERIFY_SSL=true
ADIT_ACK_MESSAGE=🤖 sedang mikir…

ADIT_AGENT_HOST=0.0.0.0
ADIT_AGENT_PORT=9000
