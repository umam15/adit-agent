# salin ke .env lalu isi, atau set langsung sebagai env var container/systemd

# --- server adit ---
ADIT_BASE_URL=http://localhost:8000
ADIT_API_KEY=
ADIT_MAX_TOKENS=150
ADIT_TEMPERATURE=0.8
ADIT_TOP_K=20
ADIT_REQUEST_TIMEOUT=120

# --- Synology Chat ---
# Profile > Integration > Bot > buat "Outgoing Webhook", isi URL-nya ke:
#   http://<host-adit-agent>:9000/webhook/synology
# lalu salin token yang digenerate ke sini.
SYNOLOGY_OUTGOING_TOKEN=

# Profile > Integration > Incoming Webhook > buat webhook baru untuk channel
# tujuan, salin URL lengkapnya (sudah termasuk ?token=...) ke sini.
SYNOLOGY_INCOMING_WEBHOOK_URL=

SYNOLOGY_VERIFY_SSL=true
ADIT_ACK_MESSAGE=🤖 sedang mikir…

ADIT_AGENT_HOST=0.0.0.0
ADIT_AGENT_PORT=9000
