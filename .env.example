# Setting adit-agent SENDIRI (level admin/server). Kredensial tiap agent
# chat (Synology Chat, Synology Bot, Telegram, dst) TIDAK diisi di sini --
# tambahkan lewat panel admin di http://<host>:9000/admin setelah adit-agent
# jalan. Lihat README.md.

# --- server adit (sumber jawaban) ---
ADIT_BASE_URL=http://localhost:8000
ADIT_API_KEY=
ADIT_MAX_TOKENS=150
ADIT_TEMPERATURE=0.8
ADIT_TOP_K=20
ADIT_REQUEST_TIMEOUT=120
ADIT_ACK_MESSAGE=🤖 sedang mikir…

# --- panel admin (/admin) & penyimpanan agent ---
# WAJIB diisi -- adit-agent tidak akan start tanpa ini. Generate SEKALI,
# simpan permanen (JANGAN generate ulang -- kredensial agent yang sudah
# tersimpan jadi tidak bisa dibaca lagi kalau key ini berubah):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADIT_AGENT_SECRET_KEY=

# Opsional -- kalau diisi, panel admin & API-nya (/api/agents/*) wajib
# header "Authorization: Bearer <token ini>". Sangat disarankan diisi kalau
# adit-agent bisa dijangkau dari luar jaringan lokal terpercaya.
ADIT_AGENT_ADMIN_TOKEN=

# Opsional -- lokasi file database SQLite tempat agent disimpan.
ADIT_AGENT_DB_PATH=data/adit-agent.db

# Opsional -- isi kalau UI panel admin dijalankan terpisah dari adit-agent
# (domain/port berbeda), supaya browser tidak diblokir CORS. Pisahkan
# dengan koma kalau lebih dari satu. Kosongkan kalau UI dibuka lewat
# /admin bawaan adit-agent sendiri (default, tidak butuh ini).
ADIT_AGENT_UI_ORIGINS=

# --- bind address ---
ADIT_AGENT_HOST=0.0.0.0
ADIT_AGENT_PORT=9000
